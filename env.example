# Copy into your local .env only for local development. Never commit real secrets.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOUR-RENDER-DOMAIN.onrender.com
APP_TIMEZONE=Africa/Kampala
SESSION_SECURE=true

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=advert-images

PESAPAL_ENVIRONMENT=sandbox
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=YOUR_SANDBOX_CONSUMER_KEY
PESAPAL_CONSUMER_SECRET=YOUR_SANDBOX_CONSUMER_SECRET
PESAPAL_CURRENCY=UGX
PESAPAL_CALLBACK_URL=https://YOUR-RENDER-DOMAIN.onrender.com/payment/return
PESAPAL_NOTIFICATION_ID=YOUR_PESAPAL_IPN_ID
PESAPAL_IPN_ID=YOUR_PESAPAL_IPN_ID

CRON_SECRET=GENERATE_A_LONG_RANDOM_SECRET
OWNER_EMAIL=OWNER_EMAIL_ADDRESS
OWNER_SETUP_TOKEN=GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET
